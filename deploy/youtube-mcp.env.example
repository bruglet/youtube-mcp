YOUTUBE_API_KEY=replace_me
PUBLIC_BASE_URL=https://youtube-mcp.example.com
AUTH_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace_me
HOST=0.0.0.0
PORT=8000

CACHE_DIR=/data/cache
MODEL_CACHE_DIR=/data/models
MAX_VIDEO_DURATION_SECONDS=3600
LONG_OPERATION_TIMEOUT_SECONDS=7200
CACHE_TTL_SECONDS=86400
CACHE_MAX_BYTES=53687091200
ARTIFACT_MAX_BYTES=8589934592

WHISPER_EN_MODEL=small.en
WHISPER_MULTILINGUAL_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_MODEL_IDLE_SECONDS=300
WHISPER_BEAM_SIZE=5
