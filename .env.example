# Optional. get_video_details and search_videos require this key.
YOUTUBE_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8000
AUTH_MODE=disabled
HOST=127.0.0.1
PORT=8000

# Required when AUTH_MODE=cloudflare.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace_me

CACHE_DIR=.cache/media
MODEL_CACHE_DIR=.cache/models
MAX_VIDEO_DURATION_SECONDS=3600
LONG_OPERATION_TIMEOUT_SECONDS=7200
CACHE_TTL_SECONDS=86400
CACHE_MAX_BYTES=53687091200
ARTIFACT_MAX_BYTES=8589934592

WHISPER_EN_MODEL=small.en
WHISPER_MULTILINGUAL_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_MODEL_IDLE_SECONDS=300
WHISPER_BEAM_SIZE=5
